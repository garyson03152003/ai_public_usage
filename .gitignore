__pycache__/
*.pyc
.pytest_cache/

# Fetched/derived data is regenerated by the fetch_*.py / combine.py
# scripts and is environment/date dependent -- don't commit it, just the
# pipeline that produces it. Keep the directory structure via .gitkeep.
/data/raw/**
/data/processed/**
!/data/raw/**/.gitkeep
!/data/processed/.gitkeep
