__pycache__/
*.pyc
.pytest_cache/

# This repo commits a snapshot of fetched/derived data (see README) so the
# combined dataset is usable without a live network. Re-run the fetch_*.py
# scripts to refresh it. The exceptions below are either regenerated
# pass-through dumps too large to be worth versioning, or sources that
# turned out to have no working automated path (see README/sources.yaml).
/data/raw/unemployment/ar9050_raw.csv
/data/raw/court_stats/**
/data/raw/controls/**
!/data/raw/court_stats/.gitkeep
!/data/raw/controls/.gitkeep

# TEMPORARY: a long-running monthly Trends fetch is still in progress and
# writes new files continuously for a couple of hours. Ignoring the rest
# of it here to avoid a flood of tiny incremental commits; the already-
# committed 2020-01 files are unaffected (gitignore doesn't touch tracked
# files). Remove this line and commit the finished directory once
# `python -m src.trends.fetch_trends --granularity month` completes.
/data/raw/trends_monthly/**
